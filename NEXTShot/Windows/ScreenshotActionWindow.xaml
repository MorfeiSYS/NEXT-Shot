<Window x:Class="NEXTShot.Windows.ScreenshotActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource Skr.PanelBrush}" BorderBrush="{StaticResource Skr.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4">
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Skr.ActionButton}" Tag="cloud" Click="Cloud_OnClick">
                <StackPanel>
                    <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Облако" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Skr.ActionButton}" Click="Save_OnClick">
                <StackPanel>
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Диск" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Skr.ActionButton}" Click="Copy_OnClick">
                <StackPanel>
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Буфер" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Skr.ActionButton}" Click="Edit_OnClick">
                <StackPanel>
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Редактор" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Skr.ActionButton}" Click="Close_OnClick">
                <StackPanel>
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Закрыть" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>