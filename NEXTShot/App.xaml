<Application x:Class="NEXTShot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SkrinshoterTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="NEXT-Shot" IconSource="/Resources/app.ico">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu Style="{StaticResource Skr.ContextMenu}">
                        <MenuItem Header="Скриншот области" Click="CaptureRegion_OnClick"/>
                        <MenuItem Header="Скриншот активного окна" Click="CaptureWindow_OnClick"/>
                        <MenuItem Header="Скриншот всего экрана" Click="CaptureFull_OnClick"/>
                        <Separator/>
                        <MenuItem x:Name="MenuVideo" Header="Запись видео" Click="ToggleVideo_OnClick"/>
                        <Separator/>
                        <MenuItem Header="Настройки…" Click="Settings_OnClick"/>
                        <MenuItem Header="Выход" Click="Exit_OnClick"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>