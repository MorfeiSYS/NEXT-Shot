<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Set.Shell.Accent">#FF2EA3FF</Color>
    <Color x:Key="Set.Shell.Bg">#FFFFFFFF</Color>
    <Color x:Key="Set.Shell.SidebarBg">#FFF5F5F5</Color>
    <Color x:Key="Set.Shell.Border">#FFE5E5E5</Color>
    <Color x:Key="Set.Shell.Text">#FF1E1E1E</Color>
    <Color x:Key="Set.Shell.Subtext">#FF6E6E6E</Color>
    <Color x:Key="Set.Shell.NavHover">#FFEBF6FF</Color>
    <SolidColorBrush x:Key="Set.Shell.AccentBrush" Color="{StaticResource Set.Shell.Accent}"/>
    <SolidColorBrush x:Key="Set.Shell.BgBrush" Color="{StaticResource Set.Shell.Bg}"/>
    <SolidColorBrush x:Key="Set.Shell.SidebarBgBrush" Color="{StaticResource Set.Shell.SidebarBg}"/>
    <SolidColorBrush x:Key="Set.Shell.BorderBrush" Color="{StaticResource Set.Shell.Border}"/>
    <SolidColorBrush x:Key="Set.Shell.TextBrush" Color="{StaticResource Set.Shell.Text}"/>
    <SolidColorBrush x:Key="Set.Shell.SubtextBrush" Color="{StaticResource Set.Shell.Subtext}"/>
    <SolidColorBrush x:Key="Set.Shell.NavHoverBrush" Color="{StaticResource Set.Shell.NavHover}"/>

    <Style x:Key="Set.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Set.Shell.TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="Set.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Set.Shell.AccentBrush}"/>
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>

    <Style x:Key="Set.NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,12"/>
    </Style>

    <Style x:Key="Set.NavItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Foreground" Value="{StaticResource Set.Shell.TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Set.Shell.NavHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Set.Shell.AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFF0F0F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Set.SecondaryButton" TargetType="Button">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Background" Value="{StaticResource Set.Shell.BgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Set.Shell.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Set.Shell.TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Set.Link" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Set.Shell.AccentBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="TextDecorations" Value="Underline"/>
    </Style>
</ResourceDictionary>
